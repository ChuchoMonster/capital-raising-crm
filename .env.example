# Copy to .env.local and fill in. Every value here is a placeholder.
# Only the first block is needed to run the demo locally.

# ── Required ──────────────────────────────────────────────────────────────
# Postgres connection. For the local demo database (see demo/README.md):
SUPABASE_DB_URL=postgres://demo@127.0.0.1:5433/crm_demo?sslmode=disable
# Auth.js session secret: generate with `openssl rand -base64 32`
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000
# Public base URL used in links inside access emails
CRM_PUBLIC_URL=http://localhost:3000

# ── Microsoft sign-in (Entra ID) ──────────────────────────────────────────
# Placeholders are fine for the demo: sign in with the password route instead.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=replace-me

# ── Mailbox sync and drafting (Microsoft Graph, app-only credentials) ─────
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=replace-me
# Comma-separated primary addresses of the mailboxes to read and draft into
GRAPH_MAILBOXES=alan@halden-ridge.example,grace@halden-ridge.example,peter@halden-ridge.example,ruth@halden-ridge.example

# ── Claude (deck write-ups, teasers, reply classification, firm lookup) ───
ANTHROPIC_API_KEY=replace-me

# ── File storage for uploaded decks and teaser images (Supabase Storage) ──
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me

# ── Transactional email for access invites and resets (Resend) ────────────
RESEND_API_KEY=replace-me
RESEND_FROM="Halden Ridge CRM <crm@send.halden-ridge.example>"
# Mailbox the CRM sends system mail from via Graph
CRM_MAIL_FROM=alan@halden-ridge.example
# Comma-separated override for who approves access requests
CRM_APPROVERS=

# ── Scheduled jobs and health check ───────────────────────────────────────
CRON_SECRET=replace-with-a-long-random-string
HEALTH_SECRET=replace-with-a-long-random-string

# ── Demo and debugging (optional) ─────────────────────────────────────────
# Used by demo/*.mjs scripts
DEMO_DB_URL=postgres://demo@127.0.0.1:5433/crm_demo
DEMO_PASSWORD=choose-a-local-password
# Set to 1 to log every teaser claim rejected by the source check, or "raw"
TEASER_DEBUG=
# Set automatically by Vercel; shown by the health check when present
VERCEL_GIT_COMMIT_SHA=
